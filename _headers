  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://omfwcodoimjmbrhssvfl.supabase.co https://vpsmikewolf.duckdns.org; frame-ancestors 'none'; form-action 'self'; object-src 'none'; base-uri 'self'
